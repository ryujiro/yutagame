{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manabi-note-local",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./frontend/dist", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "LEARNING_STORE", "class_name": "LearningStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LearningStore"]}],
  "observability": {"enabled": false}
}
