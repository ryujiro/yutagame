{
  "name": "manabi-note-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend ci --include=dev --no-audit --no-fund && npm --prefix frontend run build",
    "test": "node --test cloudflare/tests/*.test.js",
    "deploy": "wrangler deploy",
    "dev:cloudflare": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .local/cloudflare-build"
  },
  "devDependencies": {
    "@cloudflare/playwright": "1.3.6",
    "playwright-core": "1.58.2",
    "wrangler": "4.149.0"
  }
}
