{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manabi-note",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./frontend/dist", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"RECORDS_URL": "https://raw.githubusercontent.com/ryujiro/yutagame/main/public-data/dashboard.json"},
  "observability": {"enabled": false}
}
