{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manabi-note",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./frontend/dist", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"RECORDS_URL": "https://raw.githubusercontent.com/ryujiro/yutagame/main/public-data/dashboard.json"},
  "d1_databases": [{"binding":"LEDGER_DB","database_name":"manabi-time-ledger","database_id":"95a41755-b813-4745-a863-3749245360e6","migrations_dir":"cloudflare/migrations"}],
  "triggers": {"crons":["27 * * * *"]},
  "observability": {"enabled": false}
}
